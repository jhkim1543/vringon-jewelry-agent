# 키는 이 파일이 아니라 .env 에 넣는다. .env 는 gitignore 대상이다.
OPENAI_API_KEY=

# 딥리서치 · 조직 인증이 끝나면 아래를 1로 바꾼다
OPENAI_DEEP_RESEARCH_KEY=
OPENAI_DEEP_RESEARCH=0
OPENAI_DEEP_RESEARCH_MODEL=o3-deep-research

# OpenAI 이미지 호출이 실패했을 때의 예비 경로 (선택)
GEMINI_API_KEY=

# Miro 내보내기 (선택). 없으면 생성 계획 JSON을 내려받는다.
# 각 사용자는 화면의 연결 다이얼로그로 자기 토큰을 넣는다 — 이 값은 공용 폴백이다.
MIRO_ACCESS_TOKEN=


# ── 제품 사진 언블로커 (선택, 유료) ─────────────────────────────────
# 일부 명품몰(Net-a-Porter, Selfridges, Pandora 등)은 봇 차단이 강해 무료로는
# 제품 사진을 못 가져온다. 아래를 채우면 "무료 경로가 실패한 건"만 유료로 재시도한다.
# 성공한 요청에만 과금되므로, 이미 잘 되던 사이트는 계속 공짜다.
#
# 방법 A · Bright Data Web Unlocker (건당 과금, 소량이면 가장 싸다)
#   UNLOCKER_PROVIDER=brightdata
#   UNLOCKER_KEY=<API 토큰>
#   UNLOCKER_ZONE=web_unlocker1        # 대시보드에서 만든 zone 이름
#
# 방법 B · ScrapingBee / ScraperAPI / ZenRows 등 (월 구독)
#   UNLOCKER_KEY=<아무 값이나, 켜짐 표시용>
#   UNLOCKER_URL=https://app.scrapingbee.com/api/v1/?api_key=<키>&url={url}
#   ({url} 자리에 대상 주소가 들어간다)
UNLOCKER_PROVIDER=
UNLOCKER_KEY=
UNLOCKER_ZONE=
UNLOCKER_URL=
# 하루 호출 상한 · 설정 실수로 요금이 새지 않게 막는다 (기본 300)
UNLOCKER_DAILY_CAP=300
