# 키는 이 파일이 아니라 .env 에 넣는다. .env 는 gitignore 대상이다.
OPENAI_API_KEY=

# 딥리서치 · 조직 인증이 끝나면 아래를 1로 바꾼다
OPENAI_DEEP_RESEARCH_KEY=
OPENAI_DEEP_RESEARCH=0
OPENAI_DEEP_RESEARCH_MODEL=o3-deep-research

# OpenAI 이미지 호출이 실패했을 때의 예비 경로 (선택)
GEMINI_API_KEY=

# Miro 내보내기 (선택). 없으면 생성 계획 JSON을 내려받는다.
# 각 사용자는 화면의 연결 다이얼로그로 자기 토큰을 넣는다 — 이 값은 공용 폴백이다.
MIRO_ACCESS_TOKEN=

# Tripo · 멀티뷰에서 3D 모델(GLB)을 만든다
TRIPO_API_KEY=
